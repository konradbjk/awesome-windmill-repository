DATABASE_URL=postgresql://windmill:<REDACTED>@postgres-windmill:5432/windmill?sslmode=disable
MODE=worker
WORKER_GROUP=native

# Native jobs are async client calls, not spawned runtimes:
# scale with NUM_WORKERS inside one container, not with replicas.
NUM_WORKERS=8

# Poll more aggressively — native jobs are short.
SLEEP_QUEUE=200